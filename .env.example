# TankVitals — modelo de configuração (ARQUITETURA §8)
#
# Copie para .env na raiz do projeto e preencha. O .env NÃO vai para o Git.
#   cp .env.example .env

# --- MQTT ---
# Padrão (INFRA-03): broker próprio na VM, ex. mqtt.seudominio.com
# Plano B (INFRA-04): localhost, com a bridge importando do broker público
MQTT_HOST=localhost
MQTT_PORT=1883
# Obrigatórios quando o broker está na VM — lá o acesso anônimo é bloqueado.
MQTT_USERNAME=
MQTT_PASSWORD=
# Precisa ser o MESMO prefixo do sketch.ino e do mosquitto.conf.
MQTT_TOPIC_PREFIX=tankvitals
MQTT_CLIENT_ID=tankvitals-backend

# --- InfluxDB ---
INFLUX_URL=http://localhost:8086
# Token com escopo APENAS do bucket tankvitals (INFRA-02).
# Nunca use o token de admin aqui, e nunca comite este valor preenchido.
# Para o banco local do docker-compose, o token de desenvolvimento ja criado
# pelo setup automatico e: tankvitals-dev-token
INFLUX_TOKEN=
INFLUX_ORG=unifacef
INFLUX_BUCKET=tankvitals

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Faixas seguras (ARQUITETURA §5) ---
TEMP_OK_MIN=24.0
TEMP_OK_MAX=28.0
PH_OK_MIN=6.5
PH_OK_MAX=8.0
LEVEL_OK_MIN=30.0
TURBIDITY_OK_MAX=40.0

# --- Limites de critico (ARQUITETURA §5) ---
# Opcionais: o backend ja usa estes mesmos valores como padrao. So preencha
# para mexer na tabela de alerta sem alterar codigo.
# TEMP_CRIT_MIN=22.0
# TEMP_CRIT_MAX=30.0
# PH_CRIT_MIN=6.0
# PH_CRIT_MAX=8.5
# LEVEL_CRIT_MIN=15.0
# TURBIDITY_CRIT_MAX=60.0
