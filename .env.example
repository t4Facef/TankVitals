# TankVitals — modelo de configuração (ARQUITETURA §8)
#
# Copie para .env na raiz do projeto e preencha. O .env NÃO vai para o Git.
#   cp .env.example .env

# --- MQTT ---
# O broker é sempre local: o ESP32 publica no broker público e a bridge do
# mosquitto.conf importa para cá (INFRA-04).
MQTT_HOST=localhost
MQTT_PORT=1883
# Vazios: o broker local aceita conexão anônima.
MQTT_USERNAME=
MQTT_PASSWORD=
# Precisa ser o MESMO prefixo do sketch.ino e do mosquitto.conf.
MQTT_TOPIC_PREFIX=tankvitals-unifacef-g3
MQTT_CLIENT_ID=tankvitals-backend

# --- InfluxDB ---
INFLUX_URL=http://localhost:8086
# Token com escopo APENAS do bucket tankvitals (INFRA-02).
# Nunca use o token de admin aqui, e nunca comite este valor preenchido.
# No Docker Compose, o token-bootstrap cria os tokens de escopo sozinho.
INFLUX_TOKEN=
INFLUX_ORG=unifacef
INFLUX_BUCKET=tankvitals

# --- PLAT-02: credentials for infrastructure services ---
MQTT_SIMULATOR_USERNAME=simulator
MQTT_SIMULATOR_PASSWORD=
MQTT_GATEWAY_USERNAME=gateway
MQTT_GATEWAY_PASSWORD=

RABBITMQ_API_USERNAME=api
RABBITMQ_API_PASSWORD=
RABBITMQ_GATEWAY_USERNAME=gateway
RABBITMQ_GATEWAY_PASSWORD=
RABBITMQ_WRITER_USERNAME=writer
RABBITMQ_WRITER_PASSWORD=
RABBITMQ_RULES_USERNAME=rules
RABBITMQ_RULES_PASSWORD=
RABBITMQ_INFERENCE_USERNAME=inference
RABBITMQ_INFERENCE_PASSWORD=
RABBITMQ_WORKER_USERNAME=worker
RABBITMQ_WORKER_PASSWORD=

# --- PLAT-02: database, JWT, and demo credentials ---
POSTGRES_DB=tankvitals
POSTGRES_USER=tankvitals
POSTGRES_PASSWORD=
INFLUXDB_USERNAME=tankvitals
INFLUXDB_PASSWORD=
# Token inicial de administração do InfluxDB; não use como INFLUX_TOKEN da API.
INFLUXDB_ADMIN_TOKEN=
PGADMIN_DEFAULT_EMAIL=admin@tankvitals.local
PGADMIN_DEFAULT_PASSWORD=
JWT_SECRET_KEY=
DEMO_VIEWER_USERNAME=viewer
DEMO_VIEWER_PASSWORD=
DEMO_OPERATOR_USERNAME=operator
DEMO_OPERATOR_PASSWORD=
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=
# Acesso rápido de demonstração: com true, o login mostra um botão por papel e
# entra sem senha (cada entrada vai para a auditoria). Deixe false fora de
# ensaio e apresentação: qualquer um que chegue à porta 8080 entraria como admin.
DEMO_QUICK_LOGIN=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# BACK-07..10: no Compose, JWT_SECRET vem de JWT_SECRET_KEY acima.
JWT_SECRET=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Troque para false após integrar o login; o Compose repassa ao build do frontend.
VITE_MOCK=false
# Mesmo banco criado pelas migrações BACK-02; dentro do compose use o host postgres.
# ASSISTANT_DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/tankvitals
CORS_ORIGINS=http://localhost:5173

# --- Faixas seguras (ARQUITETURA §5) ---
TEMP_OK_MIN=24.0
TEMP_OK_MAX=28.0
PH_OK_MIN=6.5
PH_OK_MAX=8.0
LEVEL_OK_MIN=30.0
TURBIDITY_OK_MAX=40.0

# --- Limites de critico (ARQUITETURA §5) ---
# Opcionais: o backend ja usa estes mesmos valores como padrao. So preencha
# para mexer na tabela de alerta sem alterar codigo.
# TEMP_CRIT_MIN=22.0
# TEMP_CRIT_MAX=30.0
# PH_CRIT_MIN=6.0
# PH_CRIT_MAX=8.5
# LEVEL_CRIT_MIN=15.0
# TURBIDITY_CRIT_MAX=60.0
