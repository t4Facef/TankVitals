# Deixe vazio para usar o proxy do Vite em desenvolvimento.
VITE_API_BASE_URL=

# Modo simulado: login e dados ao vivo gerados no navegador (src/config.ts).
# Deixe true enquanto o backend não tiver o login (BACK-03) e o WebSocket com
# ticket (BACK-04); depois troque para false.
VITE_MOCK=true

# Página Ferramentas: as interfaces abertas só em 127.0.0.1 pelo compose.
# Vazio usa o padrão de cada uma (8086, 15672 e 5050).
VITE_INFLUXDB_URL=
VITE_RABBITMQ_URL=
VITE_PGADMIN_URL=
